# Change all secrets before deployment. TOKEN_SECRET must contain >=32 characters.
POSTGRES_DB=cnc_mes
POSTGRES_USER=mes_user
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DB_PASSWORD
DATABASE_URL=postgresql+psycopg://mes_user:REPLACE_WITH_LONG_RANDOM_DB_PASSWORD@db:5432/cnc_mes
TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_FOR_HMAC_SIGNING
TOKEN_TTL_SECONDS=28800
MES_ADMIN_USER=admin
MES_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_12_CHARS_MINIMUM
V1_AUTH_REQUIRED=true
AUTO_CREATE_SCHEMA=false
# IANA timezone for factory-local APS shift calendars, e.g. Asia/Tokyo or Asia/Shanghai
PLANT_TIMEZONE=Etc/UTC
CORS_ORIGINS=http://localhost:5173
# Separate shared secret for edge gateway -> API ingest; generate a unique 32+ char value.
EDGE_INGEST_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_FOR_EDGE_INGEST

# Optional OPC UA account variables referenced by edge_gateway/config.yaml (leave unset for anonymous read-only test only).
OPCUA_CNC02_USER=REPLACE_WITH_READ_ONLY_ACCOUNT
OPCUA_CNC02_PASSWORD=REPLACE_WITH_SECRET
